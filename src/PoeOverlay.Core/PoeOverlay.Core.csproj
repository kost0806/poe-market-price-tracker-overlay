<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PoeOverlay.Core</RootNamespace>
    <AssemblyName>PoeOverlay.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- D-DL0-1 (S4 2.2): the test project reaches internal wire DTOs, JsonSerializerContexts
         and the join-count hook directly. Without this it does not compile. -->
    <InternalsVisibleTo Include="PoeOverlay.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <!-- S2 1.2: Market's one allowed infrastructure dependency is IHttpClientFactory. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- S2 3.3 (D3): en.json is the floor of the fallback chain, so it ships twice — embedded in
         the assembly (level ③, which cannot be absent) and copied to Localization/ in the output
         (level ②, which a translator may edit). The link keeps the output path at
         Localization/en.json, matching {AppContext.BaseDirectory}/Localization/ (S2 3.2). -->
    <EmbeddedResource Include="Localization\Localization\en.json" LogicalName="PoeOverlay.Core.Localization.en.json" />
    <None Update="Localization\Localization\en.json" Link="Localization\en.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- ko.json is copied and not embedded (S2 3.3, S4 2.1). The chain's floor is en and only
         en: a second embedded dictionary would not add a level, it would blur which one is the
         floor, and level ③ is by definition never missed. Discovery is by file name, so this
         entry is the whole of what shipping a language costs (FR-07-3).
         The item-name half is generated — tools/build-ko-dictionary.py, S4 2.5. -->
    <None Update="Localization\Localization\ko.json" Link="Localization\ko.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
