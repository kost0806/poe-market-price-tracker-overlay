<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- S4 2.1 names the shell assembly "PoeOverlay". The project directory is
         src/PoeOverlay.Shell rather than src/PoeOverlay, so the identity is restated here. -->
    <RootNamespace>PoeOverlay</RootNamespace>
    <AssemblyName>PoeOverlay</AssemblyName>
    <!-- HLD 3.2 requires an explicit [STAThread] Main, so there is no App.xaml: an
         ApplicationDefinition would generate a second entry point. -->
    <StartupObject>PoeOverlay.Composition.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- S3 4.7 / S4 15.1 — Pretendard travels inside the assembly. Relying on an installed copy
         fails silently on any machine that has not got it: WPF substitutes and says nothing. The
         licence (SIL OFL 1.1) ships beside the faces because redistribution is conditional on it,
         and Content/PreserveNewest puts a readable copy next to the exe as well. -->
    <Resource Include="Fonts\Pretendard-Regular.otf" />
    <Resource Include="Fonts\Pretendard-SemiBold.otf" />
    <Content Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- FR-04-6 / HLD D23 — the item icons travel beside the exe, not inside it. 5.3 MB of art
         that is regenerated whenever the league turns over, and a user who wants a newer set
         should be able to drop the files into Icons/ rather than rebuild. That is the opposite
         of the typeface decision above (D-SH22) because the consequence is the opposite: a
         missing icon leaves a blank slot, a missing font silently changes every glyph.

         The PNGs are referenced where the fetch tool writes them (data/images/, curl.cfg's
         output paths) instead of being copied into this project. A copy here would put the same
         5.3 MB into the repository a second time, and again at every league. Only the generated
         manifest — the small file, the one build-icon-manifest.py produces — is committed under
         this project, exactly as ko.json is committed under Core. -->
    <Content Include="Icons\item-icons.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\images\*.png"
             Link="Icons\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoeOverlay.Core\PoeOverlay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Shell tests reach the internal composition surface: the registration table, the
         interop helpers' pure parts and the adapters. -->
    <InternalsVisibleTo Include="PoeOverlay.Shell.Tests" />
  </ItemGroup>

</Project>
