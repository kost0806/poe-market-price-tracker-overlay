<Window x:Class="PoeOverlay.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rows="clr-namespace:PoeOverlay.Core.Presentation.ViewModels.Rows;assembly=PoeOverlay.Core"
        xmlns:diag="clr-namespace:PoeOverlay.Core.Diagnostics;assembly=PoeOverlay.Core"
        Title="{Binding Strings.Title}"
        Width="620"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#FF232323"
        Foreground="#FFEDEDED"
        FontFamily="pack://application:,,,/Fonts/#Pretendard"
        FontSize="12">

    <!-- Every colour in this window is one of the overlay's (OverlayView.xaml). The palette is
         provisional pending the legibility experiment (S3 14-12), so this file invents nothing: it
         reuses the six values the overlay already paints with. Before this, the window set only its
         own Background and Foreground and left every control on the system theme — white text boxes,
         grey Win32 buttons, and combo boxes whose items inherited a near-white foreground onto a
         white popup and so read as empty. Each control below therefore states its own Background and
         Foreground rather than relying on inheritance, which is what leaked in the first place: a
         GroupBox Foreground propagates to everything inside it, including the TextBlocks a
         ContentPresenter builds, which implicit Window-level styles never reach. -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="Surface" Color="#FF232323" />
        <SolidColorBrush x:Key="Field" Color="#FF1E1E1E" />
        <SolidColorBrush x:Key="Line" Color="#FF3C3C3C" />
        <SolidColorBrush x:Key="Ink" Color="#FFEDEDED" />
        <SolidColorBrush x:Key="MutedInk" Color="#FFA0A0A0" />
        <SolidColorBrush x:Key="FaintInk" Color="#FF808080" />
        <SolidColorBrush x:Key="Accent" Color="#FF7FB2FF" />
        <SolidColorBrush x:Key="AccentFill" Color="#FF2F3B4C" />
        <SolidColorBrush x:Key="WarnInk" Color="#FFFFC35C" />
        <SolidColorBrush x:Key="ErrorInk" Color="#FFE58A8A" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,3" />
        </Style>

        <!-- Buttons, list items and the combo box get explicit templates. The system templates paint
             their own backgrounds from theme brushes, so setting Background on them changes nothing
             and the control stays light on a dark window. Each template is the smallest one that
             still shows focus and hover. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentFill}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="#FF10151C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource FaintInk}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,2" />
            <!-- F3: without this the item container is only as wide as its content, so a row's own
                 star column never stretches and the "Remove" button sits flush against the id. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Field}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentFill}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentFill}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.ColumnSpan="2"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{StaticResource Field}"
                                                BorderBrush="{StaticResource Line}"
                                                BorderThickness="1"
                                                SnapsToDevicePixels="True" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- ContentTemplateSelector is not decoration. DisplayMemberPath is
                                 implemented as an internal ItemTemplateSelector, so a presenter
                                 that forwards only SelectionBoxItemTemplate has nothing to render
                                 with and falls back to ToString(): the language box read
                                 "LanguageInfo { Tag = en, DisplayName = English }". -->
                            <ContentPresenter Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />

                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Margin="{TemplateBinding Padding}"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{StaticResource Ink}"
                                     Visibility="Collapsed"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />

                            <Path Grid.Column="1"
                                  Width="8"
                                  Height="4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="{StaticResource MutedInk}"
                                  Data="M 0,0 L 8,0 L 4,4 Z"
                                  IsHitTestVisible="False" />

                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource Field}"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The system GroupBox draws a light chrome of its own and, worse, propagates its
             Foreground into everything it contains — which is where the #B0B0B0-on-#232323 "Move
             mode" label came from. This template keeps the header and drops both problems. -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{StaticResource MutedInk}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <Border Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1"
                                    Padding="8">
                                <ContentPresenter />
                            </Border>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- First-run guidance (FR-08-6). Not a balloon: a balloon needs the tray icon the guidance
             exists to help find, and not a fourth window either (S3 6.5 D-SH6). -->
        <Border Grid.Row="0"
                Background="{StaticResource AccentFill}"
                BorderBrush="{StaticResource Accent}"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,8"
                Visibility="{Binding ShowFirstRunBanner, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding Strings.FirstRunOverflow}" />
                <TextBlock TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="{Binding Strings.FirstRunTaskbar}" />
                <Button Content="{Binding Strings.FirstRunDismiss}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Command="{Binding DismissFirstRunBannerCommand}" />
            </StackPanel>
        </Border>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Banners}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type rows:BannerViewModel}">
                    <Border Background="#FF3A2E20" Padding="6" Margin="0,0,0,4">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource WarnInk}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <GroupBox Header="{Binding Strings.SearchHeader}">
                    <StackPanel>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- The enum used to be printed straight out ("Result: CacheEmpty"). The
                             three outcomes stay distinguishable, and CacheEmpty keeps the meaning
                             the design gives it (S2 6.7): "nothing has been fetched yet", which is
                             not the same claim as "not in the cache" and must not send the user off
                             to fetch categories by hand. While the box is empty there is no search
                             to report on, so the line is not shown at all.

                             The three sentences used to be Setter values here, which is the reason
                             no dictionary could reach them (S3 5.4.4). The view model composes them
                             now; only the emphasis stays a trigger. -->
                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding SearchStatusText, Mode=OneWay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchOutcome}" Value="Found">
                                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox x:Name="SearchResultsList"
                                 ItemsSource="{Binding SearchResults}"
                                 MaxHeight="160"
                                 Margin="0,6,0,0">
                            <ListBox.ItemTemplate>
                                <!-- DisplayName, never ApiName: an unnamed hit bound straight from
                                     the Store rendered as a blank row with only its category on it.
                                     The fallback cannot live here — TargetNullValue and
                                     PriorityBinding both count a null as a binding that succeeded —
                                     so the row view model resolves it (S4 11.3 D-DL16). -->
                                <DataTemplate DataType="{x:Type rows:SearchRowViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Foreground="{StaticResource MutedInk}"
                                                   Text="{Binding CategoryLabel, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="{Binding Strings.AddToWatchlist}"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,0"
                                Command="{Binding AddToWatchlistCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=SearchResultsList}" />
                        <ItemsControl ItemsSource="{Binding UnfetchedCategories}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <!-- The row carries both halves: the caption to draw and the enum
                                     the command takes. Binding the bare enum put "AllflameEmber"
                                     on a button (S3 5.4.3 E13). -->
                                <DataTemplate DataType="{x:Type rows:CategoryRowViewModel}">
                                    <Button Content="{Binding Label}"
                                            HorizontalAlignment="Left"
                                            Margin="0,2,0,0"
                                            Padding="8,2"
                                            Command="{Binding DataContext.FetchCategoryCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Category}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <!-- FR-08-5: the full watchlist is reachable here, which is what makes the
                     overlay's "+n more" marker acceptable (S3 4.4.2). -->
                <GroupBox Header="{Binding Strings.WatchlistHeader}">
                    <ListBox ItemsSource="{Binding Watchlist}" MaxHeight="200">
                        <ListBox.ItemTemplate>
                            <!-- DisplayName, not Id.Value. This was the last list still drawing the
                                 raw slug after the search rows were moved onto the name chain
                                 (S3 5.4.3 E14). -->
                            <DataTemplate DataType="{x:Type rows:WatchlistRowViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Content="{Binding DataContext.Strings.WatchlistRemove,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            Margin="8,0,0,0"
                                            Padding="8,1"
                                            Command="{Binding DataContext.RemoveFromWatchlistCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <GroupBox Header="{Binding Strings.PreferencesHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Strings.League}" Margin="0,3,8,3" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  Margin="0,3"
                                  IsEditable="True"
                                  ItemsSource="{Binding Leagues}"
                                  DisplayMemberPath="Name"
                                  Text="{Binding Editor.League, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />

                        <!-- Empty is the ordinary state of the box above: it holds an override, and
                             with no override the league is resolved from the list. This row is what
                             says which one that is. -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Strings.LeagueInUse}" Margin="0,3,8,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Margin="0,3"
                                   Foreground="{StaticResource MutedInk}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding ActiveLeague, Mode=OneWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Strings.LeagueList}" Margin="0,3,8,3" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                            <!-- A sentence, not the LeagueListStatus member. "Suspicious" on its own
                                 never said what was suspicious about it (S3 5.4.3 E13). -->
                            <TextBlock Text="{Binding LeagueStatusText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Content="{Binding Strings.LeagueReload}" Margin="8,0,0,0" Padding="8,2" Command="{Binding ReloadLeaguesCommand}" />
                            <Button Content="{Binding Strings.RetryNow}" Margin="6,0,0,0" Padding="8,2" Command="{Binding RetryNowCommand}" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Strings.RefreshMinutes}" Margin="0,3,8,3" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Margin="0,3"
                                 Text="{Binding Editor.RefreshIntervalMinutes, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Strings.Language}" Margin="0,3,8,3" />
                        <ComboBox Grid.Row="4" Grid.Column="1"
                                  Margin="0,3"
                                  ItemsSource="{Binding Editor.Languages, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding Editor.Language, RelativeSource={RelativeSource AncestorType=Window}}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding Strings.DisplayCurrency}" Margin="0,3,8,3" />
                        <ComboBox Grid.Row="5" Grid.Column="1"
                                  Margin="0,3"
                                  ItemsSource="{Binding Editor.DisplayCurrencies, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding Editor.DefaultDisplayCurrency, RelativeSource={RelativeSource AncestorType=Window}}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding Strings.Opacity}" Margin="0,3,8,3" />
                        <Grid Grid.Row="6" Grid.Column="1" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Minimum="0.5"
                                    Maximum="1.0"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Editor.Opacity, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <!-- A slider with no readout is a slider whose value nobody can state.
                                 The overlay's own alpha is this number times 255 (measured,
                                 00-shell-measurements.md 12.3). -->
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       MinWidth="34"
                                       TextAlignment="Right"
                                       Foreground="{StaticResource MutedInk}"
                                       Text="{Binding Editor.Opacity, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:P0}, Mode=OneWay}" />
                        </Grid>

                        <TextBlock Grid.Row="7" Grid.Column="1"
                                   Margin="0,3"
                                   Foreground="{StaticResource ErrorInk}"
                                   Text="{Binding Strings.WritesBlocked}"
                                   Visibility="{Binding WritesBlocked, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="{Binding Strings.PlacementHeader}">
                    <StackPanel>
                        <!-- The one setting that is deliberately not persisted (FR-05-6). -->
                        <CheckBox Content="{Binding Strings.MoveMode}"
                                  IsChecked="{Binding IsMoveModeActive}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{Binding Strings.RevertHeight}" Command="{Binding RevertHeightCommand}" />
                            <Button Content="{Binding Strings.ResetPlacement}" Margin="6,0,0,0" Command="{Binding ResetPlacementCommand}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Binding Strings.DiagnosticsHeader}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Strings.OpenLogFolder}" Command="{Binding OpenLogFolderCommand}" />
                            <Button Content="{Binding Strings.RetryTrayRegistration}" Margin="6,0,0,0" Command="{Binding RetryTrayRegistrationCommand}" />
                            <Button Content="{Binding Strings.AcknowledgeCorrupt}" Margin="6,0,0,0" Command="{Binding AcknowledgeCorruptionCommand}" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedInk}"
                                   Text="{Binding Strings.RecentErrorsHeader}" />
                        <ListBox ItemsSource="{Binding RecentErrors}" MaxHeight="160" Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type diag:LogEntry}">
                                    <!-- The level is shown, not implied. Every entry in this list
                                         used to read as a failure whatever it was. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   MinWidth="64"
                                                   VerticalAlignment="Top"
                                                   Text="{Binding Level, Mode=OneWay}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnInk}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorInk}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorInk}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- NFR-05: attribution on both surfaces. Lowering the overlay's opacity can make its
             footer hard to read, and this is the screen where the league is chosen. -->
        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource MutedInk}"
                   TextWrapping="Wrap"
                   Text="{Binding Strings.Attribution}" />

        <TextBlock Grid.Row="4"
                   Margin="0,6,0,0"
