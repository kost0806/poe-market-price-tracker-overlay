<UserControl x:Class="PoeOverlay.Overlay.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overlay="clr-namespace:PoeOverlay.Overlay"
             xmlns:rows="clr-namespace:PoeOverlay.Core.Presentation.ViewModels.Rows;assembly=PoeOverlay.Core"
             Background="#FFFF00FF"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="pack://application:,,,/Fonts/#Pretendard"
             FontSize="12">

    <!-- This is the RootVisual of an HwndSource child hosted inside a raw layered Win32 parent; it
         is not a Window and must not become one. A WPF Window cannot hold WS_EX_LAYERED while
         AllowsTransparency is false — the bit is filtered out of every write while the call still
         reports success (00-shell-measurements.md 11.1) — and turning AllowsTransparency on kills
         ClearType outright (8.1, 0.0% chromatic ink). In the hosted child ClearType survives
         bit-identically to a plain opaque Window (11.3: 90.8% fringing, avgSpread 111.11 in both).

         The root background is the colour key rather than a real colour: anything the content does
         not cover is keyed out by the parent, exactly as if the parent had painted it (11.2).

         Everything that carries text sits on the opaque Body panel below, and it never overlaps the
         key. Glyphs drawn straight onto the key pick up a magenta halo — 73% chromatic pixels even
         in Grayscale and Aliased rendering modes (8.6, trap 1). -->
    <Border x:Name="Body" Background="#FF1E1E1E" Padding="6,4">
        <!-- The move-mode affordance is this border's BRUSH, never its Visibility. Collapsing it
             collapses everything inside it, which is the whole overlay: the shipped build did
             exactly that and rendered as an empty 420x8 strip. The thickness is constant so
             entering move mode does not reflow the content, and "off" is the Body colour rather
             than Transparent — one less question about what Transparent means on this surface
             (00-shell-measurements.md 8.6, trap 3). -->
        <Border x:Name="MoveModeBorder"
                BorderBrush="#FF1E1E1E"
                BorderThickness="1"
                Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding Banners}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type rows:BannerViewModel}">
                            <TextBlock Text="{Binding Text}"
                                       Foreground="#FFFFC35C"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="1" x:Name="RowsHost" ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <overlay:ClippingRowsPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type rows:PriceRowViewModel}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The icon (FR-04-6, S3 4.10). The row carries a slug, not a
                                     picture: the view picks the image from Id exactly as the
                                     column beside it picks a brush from Change.Direction, so
                                     PriceRowViewModel still carries no brush, no icon, no pixel.

                                     Width and Height are fixed and the column is never collapsed.
                                     An Image with a null Source still occupies its Width, which is
                                     the point — roughly 40% of the catalogue (every divination
                                     card bar the shared art, plus anything the manifest misses)
                                     would otherwise start its name 21px further left than the row
                                     above it.

                                     BitmapScalingMode is not decoration. The colour-key argument in
                                     00-shell-measurements.md 14.4 — that downscaling cannot invent
                                     a #FF00FF pixel and therefore cannot punch a click-through
                                     hole — holds because Fant and bilinear are convex kernels. A
                                     sharpening filter would overshoot and void it. -->
                                <Image Grid.Column="0"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Id, Mode=OneWay, Converter={StaticResource ItemIcon}}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Foreground="#FFEDEDED"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Price.Text}"
                                           Foreground="#FFEDEDED"
                                           Margin="8,0,0,0" />
                                <!-- One run, not two. Change.Text already begins with the glyph
                                     (ui.price.change is "{0}{1}%" and Pricing passes the glyph as
                                     {0}), so binding Change.Glyph beside it printed every arrow
                                     twice — "▼ ▼5.0%" on every row. Change.Glyph stays on the
                                     record for callers that want the sign on its own.

                                     The brush comes from Change.Direction, never from the string:
                                     HLD 6.3 puts the glyph and the number in Pricing and the colour
                                     in the View for exactly this reason — telling Flat from Unknown
                                     by comparing text breaks on a language change. -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Change.Text, Mode=OneWay}"
                                           Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFA0A0A0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Change.Direction}" Value="Up">
                                                    <Setter Property="Foreground" Value="#FF7FD18C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Change.Direction}" Value="Down">
                                                    <Setter Property="Foreground" Value="#FFE58A8A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2"
                           x:Name="MoreRows"
                           Text="{Binding MoreRowsText}"
                           Foreground="#FFA0A0A0"
                           Margin="0,2,0,0" />

                <!-- The footer is the clipping-exempt fixed region (D19) and the unit of the
                     minimum-visible-area rule (S3 4.5 D-SH8). -->
                <Grid Grid.Row="3" Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding FooterAttribution}"
                               Foreground="#FF808080"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding FooterRelativeTime}"
                               Foreground="#FF808080"
                               FontSize="10"
                               Margin="6,0,0,0" />

                    <!-- Move-mode grip. A column of the footer rather than a free-floating overlay
                         on top of it: laid over the footer it covered the relative time, which is
                         the half of the footer that changes. Auto width means the column costs
                         nothing at all while the grip is Collapsed, so leaving move mode gives the
                         time its space straight back. Inset into painted pixels — the colour-keyed
                         region passes clicks through whatever shape it is (HLD D4-c, S3 4.0.1). -->
                    <Rectangle Grid.Column="2"
                               x:Name="ResizeGrip"
                               Width="12"
                               Height="12"
                               Fill="#FF7FB2FF"
                               Margin="6,0,0,0"
                               VerticalAlignment="Bottom"
                               Cursor="SizeNWSE"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
