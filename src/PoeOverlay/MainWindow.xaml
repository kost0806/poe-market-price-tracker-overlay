<Window x:Class="PoeOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE Overlay"
        Width="420" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border x:Name="RootBorder" Background="#DD1E1E2E" CornerRadius="8" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Header -->
                <RowDefinition Height="Auto" />  <!-- Opacity slider -->
                <RowDefinition Height="*" />     <!-- Watchlist -->
                <RowDefinition Height="Auto" />  <!-- Bottom bar -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="PoE Market Overlay"
                       Foreground="#E0E0E0"
                       FontSize="18" FontWeight="Bold"
                       Margin="0,0,0,8" />

            <!-- Opacity slider -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Opacity:" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="OpacitySlider"
                        Width="150"
                        Minimum="0.2" Maximum="1.0" Value="0.87"
                        VerticalAlignment="Center"
                        ValueChanged="OpacitySlider_ValueChanged" />
            </StackPanel>

            <!-- Watchlist -->
            <!-- TODO: 관심 목록 시세 표시. 설계문서 확정 후 구현합니다. -->
            <Border Grid.Row="2" Background="#30FFFFFF" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <TextBlock Text="Watchlist"
                           Foreground="#B0B0B0"
                           FontSize="12"
                           VerticalAlignment="Top" />
            </Border>

            <!-- Bottom bar -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="✕ Close"
                        HorizontalAlignment="Left"
                        Foreground="#E0E0E0"
                        Background="#60FF4444"
                        BorderThickness="0"
                        Padding="12,4"
                        Cursor="Hand"
                        Click="CloseButton_Click" />

                <!-- Status text -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Foreground="#808080"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <!-- Drag grip handle -->
                <Border x:Name="DragGrip"
                        Grid.Column="2"
                        Width="30" Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#60FFFFFF"
                        CornerRadius="4"
                        Cursor="SizeAll"
                        ToolTip="Drag to move window"
                        MouseLeftButtonDown="DragGrip_MouseLeftButtonDown">
                    <TextBlock Text="⠿"
                               Foreground="#C0C0C0"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
