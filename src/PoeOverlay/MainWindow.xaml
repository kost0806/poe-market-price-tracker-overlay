<Window x:Class="PoeOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="PoE Overlay"
        Width="520" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border x:Name="RootBorder" Background="#DD1E1E2E" CornerRadius="8" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Header -->
                <RowDefinition Height="Auto" />  <!-- Search bar -->
                <RowDefinition Height="Auto" />  <!-- Opacity slider -->
                <RowDefinition Height="200" />   <!-- Chart -->
                <RowDefinition Height="Auto" />  <!-- Item info -->
                <RowDefinition Height="*" />     <!-- Trade listings -->
                <RowDefinition Height="Auto" />  <!-- Bottom bar -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="PoE Market Overlay"
                       Foreground="#E0E0E0"
                       FontSize="18" FontWeight="Bold"
                       Margin="0,0,0,8" />

            <!-- Search bar -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Text="{Binding SearchItemName, UpdateSourceTrigger=PropertyChanged}"
                         Background="#40FFFFFF"
                         Foreground="#E0E0E0"
                         BorderThickness="0"
                         Padding="8,6"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         KeyDown="SearchBox_KeyDown" />

                <Button Grid.Column="1"
                        Content="Search"
                        Margin="4,0,0,0"
                        Padding="12,6"
                        Foreground="#E0E0E0"
                        Background="#604CAF50"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SearchButton_Click" />

                <Button Grid.Column="2"
                        Content="↻"
                        Margin="4,0,0,0"
                        Padding="8,6"
                        Foreground="#E0E0E0"
                        Background="#60607D8B"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="16"
                        ToolTip="Refresh price data"
                        Click="RefreshButton_Click" />
            </Grid>

            <!-- Opacity slider -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Opacity:" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="OpacitySlider"
                        Width="150"
                        Minimum="0.2" Maximum="1.0" Value="0.87"
                        VerticalAlignment="Center"
                        ValueChanged="OpacitySlider_ValueChanged" />
            </StackPanel>

            <!-- Line chart -->
            <oxy:PlotView Grid.Row="3"
                          Model="{Binding ChartModel}"
                          Background="Transparent"
                          Margin="0,0,0,8" />

            <!-- Item info -->
            <Border Grid.Row="4" Background="#30FFFFFF" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding ItemImage}"
                           Height="48" Width="48"
                           Stretch="Uniform"
                           Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ItemDisplayName}"
                                   Foreground="#E0E0E0"
                                   FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentPrice}"
                                   Foreground="#FFD700"
                                   FontSize="13" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Trade listings -->
            <Border Grid.Row="5" Background="#30FFFFFF" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Trade Listings" Foreground="#B0B0B0" FontSize="12" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding TradeResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#20FFFFFF" CornerRadius="2" Padding="6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Foreground="#C0C0C0" FontSize="12">
                                            <Run Text="{Binding SellerAccount, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1"
                                                   Foreground="#FFD700" FontSize="12" FontWeight="SemiBold">
                                            <Run Text="{Binding Price, Mode=OneWay, StringFormat='{}{0:N0}'}" />
                                            <Run Text="{Binding CurrencyType, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Bottom bar -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="✕ Close"
                        HorizontalAlignment="Left"
                        Foreground="#E0E0E0"
                        Background="#60FF4444"
                        BorderThickness="0"
                        Padding="12,4"
                        Cursor="Hand"
                        Click="CloseButton_Click" />

                <!-- Status text -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Foreground="#808080"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <!-- Drag grip handle -->
                <Border x:Name="DragGrip"
                        Grid.Column="2"
                        Width="30" Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#60FFFFFF"
                        CornerRadius="4"
                        Cursor="SizeAll"
                        ToolTip="Drag to move window"
                        MouseLeftButtonDown="DragGrip_MouseLeftButtonDown">
                    <TextBlock Text="⠿"
                               Foreground="#C0C0C0"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
