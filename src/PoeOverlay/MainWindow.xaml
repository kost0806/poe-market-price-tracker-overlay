<Window x:Class="PoeOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="PoE Overlay"
        Width="520" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#DD1E1E2E" CornerRadius="8" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="PoE Market Overlay"
                       Foreground="#E0E0E0"
                       FontSize="18" FontWeight="Bold"
                       Margin="0,0,0,8" />

            <!-- Opacity slider -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Opacity:" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="OpacitySlider"
                        Width="150"
                        Minimum="0.2" Maximum="1.0" Value="0.87"
                        VerticalAlignment="Center"
                        ValueChanged="OpacitySlider_ValueChanged" />
            </StackPanel>

            <!-- Line chart -->
            <oxy:PlotView Grid.Row="2"
                          x:Name="ChartView"
                          Background="Transparent"
                          Margin="0,0,0,8" />

            <!-- Sample image -->
            <Border Grid.Row="3" Background="#30FFFFFF" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Sample Image" Foreground="#B0B0B0" FontSize="12" Margin="0,0,0,4" />
                    <Image x:Name="SampleImage"
                           Height="80"
                           Stretch="Uniform"
                           HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Fetched text -->
            <Border Grid.Row="4" Background="#30FFFFFF" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Fetched Content" Foreground="#B0B0B0" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock x:Name="FetchedTextLabel"
                               Text="Loading..."
                               Foreground="#E0E0E0"
                               TextWrapping="Wrap"
                               MaxHeight="80" />
                </StackPanel>
            </Border>

            <!-- Bottom bar with close button and drag grip -->
            <Grid Grid.Row="5">
                <Button Content="✕ Close"
                        HorizontalAlignment="Left"
                        Foreground="#E0E0E0"
                        Background="#60FF4444"
                        BorderThickness="0"
                        Padding="12,4"
                        Cursor="Hand"
                        Click="CloseButton_Click" />

                <!-- Drag grip handle (bottom-right, 30x30) -->
                <Border x:Name="DragGrip"
                        Width="30" Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#60FFFFFF"
                        CornerRadius="4"
                        Cursor="SizeAll"
                        ToolTip="Drag to move window"
                        MouseLeftButtonDown="DragGrip_MouseLeftButtonDown">
                    <TextBlock Text="⠿"
                               Foreground="#C0C0C0"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
